{
  "name": "network-packet-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Project 10: a React and Express network protocol packet visualization laboratory.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --config vite.config.ts",
    "dev:server": "tsx server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build --config vite.config.ts",
    "start": "node dist/server/index.js",
    "preview": "vite preview --config vite.config.ts",
    "test": "tsc -p tsconfig.server.json && node test/run.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
